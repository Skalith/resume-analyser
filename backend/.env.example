# Resume Job Matcher — configuration template
# Copy to `.env` and fill in real values.  Never commit the real `.env`.
#
# Start the server:
#   cd backend
#   uvicorn src.main:app --host 0.0.0.0 --port 8000 --reload

# ---------------------------------------------------------------------------
# FastAPI server
# ---------------------------------------------------------------------------

HOST=127.0.0.1
PORT=8000

# Simple API-key auth for all API endpoints (dashboard and docs stay public).
# Leave empty to disable auth (dev mode only — don't leave blank in production).
API_KEY=

# ---------------------------------------------------------------------------
# Resume
# ---------------------------------------------------------------------------

# Path to your resume PDF (relative to the backend/ directory, or absolute).
# The built-in sample is fictional; uploaded resumes are saved as resumes/resume.pdf.
RESUME_PATH=resumes/sample_resume.pdf

# ---------------------------------------------------------------------------
# Job fetching
# ---------------------------------------------------------------------------

# Job source: remotive | adzuna | email
JOB_SOURCE=remotive
JOBS_LIMIT=50

# ---------------------------------------------------------------------------
# Matching
# ---------------------------------------------------------------------------

# Threshold (0–1). Jobs scoring below this fraction are discarded.
# 0.20 = 20% — a reasonable starting value; raise to 0.30–0.40 for stricter filtering.
THRESHOLD=0.20

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------

# Channel to use: telegram | discord | none
# "none" is safe for local demos and requires no credentials.
NOTIFY_CHANNEL=none

# Telegram bot (create one at https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord webhook
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Adzuna API (https://developer.adzuna.com/) — only if JOB_SOURCE=adzuna
# ---------------------------------------------------------------------------

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Two-letter country code for job search (gb, us, in, au, ca, …)
ADZUNA_COUNTRY=gb

# ---------------------------------------------------------------------------
# Email / IMAP (LinkedIn Job Alert inbox) — only if JOB_SOURCE=email
# ---------------------------------------------------------------------------

IMAP_HOST=imap.gmail.com
EMAIL_USER=
EMAIL_PASS=

# ---------------------------------------------------------------------------
# Optional LLM layer (off by default)
# Set USE_LLM=true to enable AI-generated fit summaries per job.
# ---------------------------------------------------------------------------

USE_LLM=false

# Primary LLM route: OmniRoute (handles its own routing + fallback internally)
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=gpt-4o-mini

# Fallback providers (tried in order if OmniRoute is unset or fails)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-405b-instruct

# ---------------------------------------------------------------------------
# Optional Langfuse tracing (only used when USE_LLM=true)
# Get keys at https://cloud.langfuse.com → Project settings → API keys
# ---------------------------------------------------------------------------

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
